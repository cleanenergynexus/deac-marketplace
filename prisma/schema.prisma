// DEAC Marketplace data model.
// "Enum-like" fields are strings; allowed values live in lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String // ADMIN | INVESTOR | DEVELOPER | AGENT (referral agent, see lib/agents.ts)
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED (agents: APPROVED | SUSPENDED)
  investorId   String?  @unique
  investor     Investor? @relation(fields: [investorId], references: [id])
  developerId  String?  @unique
  developer    Developer? @relation(fields: [developerId], references: [id])
  // Staff only (role ADMIN = team login). What a team member can see, see lib/tasks.ts:
  // ADMIN sees everything, MANAGER sees their own and their direct reports' tasks, SUPPORT sees only their own.
  staffLevel   String   @default("ADMIN") // ADMIN | MANAGER | SUPPORT
  managerId    String? // the manager this team member reports to
  manager      User?    @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]   @relation("Reports")
  tasks        Activity[] @relation("TaskAssignee")
  phone        String? // E.164. Shown to a team member's referral agents, and on the agent's own profile
  company      String? // referral agents: their own firm
  bookingUrl   String? // team members: meeting booking link (Calendly, HubSpot...) shown to their referral agents
  // Referral agents: the DEAC partner (a team login) who supports their deals and meetings.
  partnerId    String?
  partner      User?    @relation("AgentPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  agents       User[]   @relation("AgentPartner")
  referredDevelopers Developer[] @relation("ReferredDevelopers")
  referredContacts   Contact[]   @relation("ReferredContacts")
  referredInvestors  Investor[]  @relation("ReferredInvestors")
  // Direct invite from the Investor CRM (lib/invites.ts): SHA-256 of the one-time link token. Cleared once they set a password.
  // Indexed, not @unique: adding a unique column makes the build's `prisma db push` stop for a data-loss prompt.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  createdAt    DateTime @default(now())

  @@index([inviteTokenHash])
}

// ---------- Investor CRM ----------
// An investor firm (fund, family office, lender...). Its people are Investor rows; the board tracks each person's interest in each listing.
model InvestorFirm {
  id           String   @id @default(cuid())
  name         String
  investorType String? // INVESTOR_TYPES in lib/constants.ts
  website      String?
  linkedin     String?
  aum          Float? // assets under management, USD
  // Mailing address. country is a two-letter code (lib/phone.ts COUNTRIES); region is the US state code for US addresses.
  street       String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  source       String?
  owner        String? // team member responsible
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investors Investor[]
}

// A person at an investor firm (the Investor CRM contact). Their login, NDAs and LOIs hang off this row.
model Investor {
  id              String   @id @default(cuid())
  name            String
  firm            String? // company name, mirrored from firmId's InvestorFirm for older screens and email templates
  firmId          String?
  company         InvestorFirm? @relation(fields: [firmId], references: [id], onDelete: SetNull)
  email           String   @unique
  phone           String? // E.164, see lib/phone.ts
  mobile          String?
  linkedin        String?
  title           String?
  // Mailing address. country is a two-letter code; region is the US state code for US addresses.
  street          String?
  city            String?
  region          String?
  postalCode      String?
  country         String?
  investorType    String? // Family Office, Infrastructure Fund, PE, Strategic, Hyperscaler, Lender, HNWI
  checkMin        Float?
  checkMax        Float?
  preferredStates String   @default("") // comma separated, e.g. "TX,VA,PR"
  preferredRegions String  @default("") // comma separated codes from lib/regions.ts, e.g. "NORTH_AMERICA,MENA"
  dealTypes       String   @default("") // comma separated: LEASE,FINANCING,SALE
  facilityTypes   String   @default("")
  mwMin           Float?
  mwMax           Float?
  accredited      Boolean  @default(false)
  ndaSigned       Boolean  @default(false)
  stage           String   @default("PROSPECT") // pipeline stage, see lib/constants.ts
  source          String? // Referral, Conference, LinkedIn, Website, Import...
  tags            String   @default("")
  notes           String?
  owner           String? // team member responsible
  referredById    String? // referral agent who brought this contact in; they see it read-only in their portal
  referredBy      User?    @relation("ReferredInvestors", fields: [referredById], references: [id], onDelete: SetNull)
  lastContactAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User?
  lois             Loi[]
  dealSteps        DealStep[]
  activities       Activity[]
  analysisRequests AnalysisRequest[]
  campaignSends    CampaignRecipient[]
  interests        InvestorInterest[]
  favorites        Favorite[]

  @@index([firmId])
  @@index([referredById])
}

// One tile on the Investor CRM board: an investor contact working one listing. Its column comes from the
// investor funnel for the listing's deal type (lib/pipeline.ts, PipelineSettings row "investor").
model InvestorInterest {
  id         String   @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage      String
  source     String? // how they came to the listing: Added by team, NDA, LOI, Intake request...
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([investorId, projectId])
  @@index([projectId])
}

// ---------- Developer CRM ----------
// A listing an investor starred on the marketplace. Shown under Favorites in My Portal; no NDA needed.
model Favorite {
  id         String   @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([investorId, projectId])
  @@index([projectId])
}

model Developer {
  id          String   @id @default(cuid())
  company     String
  contactName String
  email       String
  phone       String? // E.164, see lib/phone.ts
  website     String?
  hq          String?
  // Mailing address. country is a two-letter code (lib/phone.ts COUNTRIES); region is the US state code for US addresses.
  street      String?
  city        String?
  region      String?
  postalCode  String?
  country     String?
  experience  String? // track record narrative
  mwDelivered Float?
  stage       String   @default("LEAD") // used on the CRM board only while the developer has no projects; see lib/constants.ts
  source      String?
  notes       String?
  owner       String?
  referredById String? // referral agent who brought this company in; they see it and all its contacts and projects
  referredBy   User?   @relation("ReferredDevelopers", fields: [referredById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User?
  team       TeamMember[]
  contacts   Contact[]
  projects   Project[]
  activities Activity[]
}

// A person at a developer company. The Developer CRM board leads with the contact; projects hang off the company.
// The primary contact is mirrored into Developer.contactName/email/phone for older screens.
model Contact {
  id          String    @id @default(cuid())
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  name        String
  title       String?
  email       String?
  phone       String?
  mobile      String?
  linkedin    String?
  location    String?
  // Mailing address. country is a two-letter code (lib/phone.ts COUNTRIES); region is the US state code for US addresses.
  street      String?
  city        String?
  region      String?
  postalCode  String?
  country     String?
  source      String?
  owner       String? // team member responsible
  notes       String?
  referredById String? // referral agent who brought this contact in; they see the contact, its company's projects and its activity
  referredBy   User?   @relation("ReferredContacts", fields: [referredById], references: [id], onDelete: SetNull)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects   Project[]
  activities Activity[]

  @@index([developerId])
  @@index([referredById])
}

model TeamMember {
  id          String    @id @default(cuid())
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  name        String
  title       String
  bio         String
  photoUrl    String?
  sortOrder   Int       @default(0)
}

// ---------- Listings ----------
model Project {
  id            String    @id @default(cuid())
  code          String    @unique // public listing code, e.g. DEAC-TX-001
  title         String
  developerId   String
  developer     Developer @relation(fields: [developerId], references: [id])
  state         String // 2-letter
  city          String?
  mw            Float
  facilityType  String // see lib/constants.ts
  dealType      String // LEASE | FINANCING | SALE
  fundingNeeded Float // USD
  projectStatus String // development stage, e.g. "Site Control", "Permitting", "Under Construction", "Operating"
  summary       String
  highlights    String   @default("") // newline separated bullets
  term          String? // e.g. "24 mo", "15-yr lease"
  dealStage     String   @default("MARKETING") // deal pipeline, see DEAL_STAGES in lib/constants.ts
  pipelineStage String? // Developer CRM board stage (DEVELOPER_STAGES). Null = older project, follows its developer's stage.
  contactId     String? // point of contact at the developer for this project. Null = the developer's primary contact.
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  useOfFunds    String   @default("") // one "Label: amount" per line
  coverImageUrl String?

  // Economics (shown after access is granted)
  totalCapex      Float?
  targetIrr       Float? // %
  equityMultiple  Float?
  leaseRateKwMo   Float? // $/kW/month
  powerRateCents  Float? // ¢/kWh
  powerStatus     String? // Live | Signed | Queued | Speculative
  monthsToPower   Int?
  codDate         String?
  capitalStack    String? // free text: senior debt / pref / common
  economicsNotes  String?

  // Internal scoring (Excel bid calculator inputs + results). Never shown to investors.
  valuationInputs String? // JSON
  valueScore      Int?
  adjustedValueMw Float?

  // Staged disclosure (lib/disclosure.ts): JSON map of listing section -> stage that unlocks it.
  disclosure String?
  ndaUrl     String? // link to the project NDA investors accept before the NDA stage

  visibility String   @default("DRAFT") // DRAFT | PRIVATE (approved investors) | TEASER (also on public embed)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  documents        Document[]
  dataRoomFolders  DataRoomFolder[]
  dataRoomFiles    DataRoomFile[]
  wizardDocs       WizardDocument[]
  lois             Loi[]
  dealSteps        DealStep[]
  analysisRequests AnalysisRequest[]
  activities       Activity[]
  interests        InvestorInterest[]
  favorites        Favorite[]
}

model Document {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  category  String // Teaser, Financial Model, Interconnection, Site Plan, Environmental, Legal, Other
  url       String // external link (Drive, SharePoint...), or /api/data-room/files/<fileId> for a data room file
  access    String   @default("LOI") // stage that unlocks it: TEASER | NDA | LOI | DILIGENCE (legacy: SUMMARY = TEASER, DATAROOM = LOI)
  fileId    String? // set when the document is a file from the project's data room
  file      DataRoomFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ---------- Project data room (internal file manager; listing documents pick files from here) ----------
model DataRoomFolder {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String? // null = top level
  parent    DataRoomFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DataRoomFolder[] @relation("FolderTree")
  files     DataRoomFile[]
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([projectId])
}

model DataRoomFile {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId    String? // null = top level
  folder      DataRoomFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name        String
  size        Float // bytes
  contentType String          @default("application/octet-stream")
  storageKey  String // Vercel Blob pathname (private store), or "local:<path>" in local development
  uploadedBy  String?
  uploadedById String? // the login that uploaded it; referral agents see only their own uploads
  documents   Document[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
}

// Document Wizard draft (teaser, report, pitch deck or custom report) written by Claude from the data room.
// The team edits the Markdown, then saves it into the data room as PDF (decks also as PowerPoint).
model WizardDocument {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String // TEASER | REPORT | DECK | CUSTOM (lib/wizard.ts)
  title       String
  status      String   @default("GENERATING") // GENERATING | READY | FAILED
  error       String?
  markdown    String   @default("")
  options     String   @default("{}") // JSON WizardOptions: anonymous, webResearch, instructions, audience
  sourceIds   String   @default("[]") // JSON array of data room file ids chosen as sources
  sourceNotes String   @default("[]") // JSON: files read and files skipped (with reasons)
  webSources  String   @default("[]") // JSON: [{ title, url }] pages found by web research
  fileId      String? // saved PDF in the data room (kept on re-save so listing links stay valid)
  pptxFileId  String? // pitch decks: the PowerPoint version
  savedAt     DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// Letter of interest. APPROVED unlocks that project's data room for that investor.
model Loi {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])
  amount     Float?
  structure  String? // Lease / Debt / Equity / Acquisition
  timeline   String?
  message    String?
  status     String   @default("PENDING") // PENDING | APPROVED | DECLINED
  reviewedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([projectId, investorId])
}

// Admin-confirmed steps around the LOI: NDA (before) and full diligence access (after).
model DealStep {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId  String
  investor    Investor  @relation(fields: [investorId], references: [id], onDelete: Cascade)
  step        String // NDA | DILIGENCE
  status      String    @default("PENDING") // PENDING | APPROVED | DECLINED
  signerName  String?
  signerTitle String?
  message     String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([projectId, investorId, step])
}

// Investor intake: what they need to analyze a project. The team organizes the data room package around it.
model AnalysisRequest {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  investorId    String
  investor      Investor @relation(fields: [investorId], references: [id])
  focusAreas    String // comma separated
  returnMetric  String? // IRR, Cash yield, Cap rate, DSCR...
  holdPeriod    String?
  format        String? // Excel model, PDF memo, Call
  questions     String?
  status        String   @default("OPEN") // OPEN | IN_PROGRESS | DELIVERED
  deliverableUrl String?
  createdAt     DateTime @default(now())
}

model Activity {
  id          String     @id @default(cuid())
  investorId  String?
  investor    Investor?  @relation(fields: [investorId], references: [id], onDelete: Cascade)
  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  contactId   String? // developer contact this touchpoint was with
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId   String? // project it was about, if any
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind        String // NOTE | CALL | EMAIL | MEETING | TASK | STAGE | SYSTEM
  subject     String? // email subject / task title / meeting title
  body        String
  outcome     String? // calls: CONNECTED, VOICEMAIL... emails: SENT | RECEIVED
  dueAt       DateTime? // tasks
  doneAt      DateTime? // tasks: completed
  assigneeId  String? // tasks: team member responsible. Null = unassigned (only Admins see these)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  by          String?
  createdAt   DateTime   @default(now()) // when it happened (can be back-dated when logging)

  @@index([contactId])
  @@index([assigneeId])
}

// ---------- Outreach ----------
model Campaign {
  id         String   @id @default(cuid())
  name       String
  subject    String
  body       String // supports {{name}} and {{firm}}
  segment    String // JSON filter: { stages, states, dealTypes, investorTypes }
  status     String   @default("DRAFT") // DRAFT | SENT
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  status     String // SENT | LOGGED | FAILED
  error      String?
  createdAt  DateTime @default(now())
}

// Editable value-score model (Admin → Scoring settings). One row, id "default". JSON shape: ScoringConfig in lib/scoring.ts.
model ScoringSettings {
  id        String   @id @default("default")
  config    String // JSON
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// CRM funnels: Kanban columns per deal type (lib/pipeline.ts). Row "default" = Developer CRM, row "investor" = Investor CRM.
model PipelineSettings {
  id        String   @id @default("default")
  config    String // JSON
  updatedBy String?
  updatedAt DateTime @updatedAt
}
