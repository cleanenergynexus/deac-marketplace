# SQLite for local dev. For production use Postgres: change provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"
# Long random string used to sign login sessions.
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: Resend API key for outreach emails. Without it, campaigns are logged, not sent.
RESEND_API_KEY=""
OUTREACH_FROM="DEAC Marketplace <invest@deacna.com>"
