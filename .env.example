# Postgres connection string (Neon, Supabase, Vercel Postgres, or local Docker).
DATABASE_URL="postgresql://user:password@localhost:5432/deac"
# Long random string used to sign login sessions.
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: Resend API key for outreach emails. Without it, campaigns are logged, not sent.
RESEND_API_KEY=""
OUTREACH_FROM="DEAC Marketplace <invest@deacna.com>"
# Public URL of this app, used by the deacna.com embed links.
PUBLIC_APP_URL="https://marketplace.deacna.com"
# One-time code for /setup, which creates the first admin login. Remove after use.
SETUP_TOKEN=""
# Anthropic API key for Admin → Listings → Import from document (Claude reads deal PDFs).
ANTHROPIC_API_KEY=""
# Private Vercel Blob store for project data rooms (Vercel → Storage → Blob, Private access). Without it, local dev saves files in ./.data-room.
BLOB_READ_WRITE_TOKEN=""
# Gmail linking (My account → Gmail). Google Cloud OAuth client (Web application) with redirect URI <PUBLIC_APP_URL>/api/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Encrypts the stored Gmail tokens. Generate with: openssl rand -base64 32
GMAIL_TOKEN_KEY=""
# Protects the nightly Gmail sync cron (vercel.json). Any long random string.
CRON_SECRET=""
# Optional: days of email pulled the first time someone links Gmail (default 90).
GMAIL_SYNC_DAYS=""
